# Copy this file to .env and fill in any values you want to override.
# Defaults work out of the box with `make up`.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://pitwall:pitwall@localhost:5432/pitwall


# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=true
TESTING=false

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000


# Cloudflare R2 (for telemetry artifacts)
TELEMETRY_STORAGE_MODE=files
TELEMETRY_ARTIFACT_BACKEND=r2
TELEMETRY_ARTIFACT_BUCKET=pitwall-telemetry
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

RACE_VECTOR_INDEX_DIR=./lancedb
RACE_VECTOR_TABLE=race_intelligence_events

# Strategy documents (Task 7): originals live outside Postgres
STRATEGY_DOCUMENT_DIR=./strategy_documents
STRATEGY_DOCUMENT_BACKEND=local
STRATEGY_DOCUMENT_BUCKET=

# Cloudflare Vectorize retrieval (Task 8). Leave blank to use local LanceDB.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_VECTORIZE_API_TOKEN=
CLOUDFLARE_VECTORIZE_INDEX=
STRATEGY_VECTOR_TABLE=strategy_document_chunks
STRATEGY_RETRIEVAL_LIMIT=6

# Embedding provider (OpenAI-compatible). Blank key -> local dev embedding.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_ROUTING_MODEL=openai/gpt-4o-mini
OPENROUTER_FINAL_MODEL=openai/gpt-4o-mini
AGENT_FREE_DAILY_LIMIT=10

# Clerk identity (Phase 3)
CLERK_ISSUER=
CLERK_ADMIN_USER_IDS=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
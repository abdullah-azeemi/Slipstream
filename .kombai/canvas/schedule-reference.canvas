      },
      "html": "<div class=\"schedule-reference\" data-kid=\"1\" data-name=\"schedule page container\" style=\"--page-bg:#f7f8fc;--ink:#19243a;--muted:#748096;--soft:#eef1f7;--line:#e0e5ee;--red:#e8002d;--card:#fbfcfe;min-height:100vh;width:100%;background:var(--page-bg);color:var(--ink);font-family:'Inter',ui-sans-serif,system-ui,sans-serif;padding:18px 6px 20px;overflow:hidden;\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n    .schedule-reference,.schedule-reference *{box-sizing:border-box}\n    .schedule-hero{position:relative;width:100%;height:116px;overflow:hidden;border:1px solid #e3e7ef;border-radius:8px;background:#e8edf4;box-shadow:0 2px 7px rgba(36,49,75,.04)}\n    .schedule-hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 48%;opacity:.19;filter:grayscale(.55) saturate(.65) contrast(.9)}\n    .hero-wash{position:absolute;inset:0;background:linear-gradient(100deg,rgba(255,255,255,.94) 0%,rgba(245,247,251,.76) 47%,rgba(232,237,245,.68) 100%)}\n    .hero-grid{position:absolute;inset:0;opacity:.22;background-image:linear-gradient(115deg,transparent 0 38%,rgba(160,173,194,.45) 38.4%,transparent 39%),linear-gradient(24deg,transparent 0 57%,rgba(160,173,194,.35) 57.4%,transparent 58%),linear-gradient(90deg,rgba(255,255,255,.32) 1px,transparent 1px),linear-gradient(rgba(255,255,255,.25) 1px,transparent 1px);background-size:auto,auto,24px 24px,24px 24px}\n    .hero-copy{position:absolute;inset:0;padding:17px 13px 10px;display:flex;flex-direction:column;justify-content:space-between}\n    .hero-topline{font-size:4.4px;line-height:1;text-transform:uppercase;letter-spacing:.16em;color:#9c4a59;font-weight:800;white-space:nowrap}\n    .hero-title-row{display:flex;align-items:center;justify-content:space-between;margin-top:8px;gap:7px}\n    .hero-title{font-size:13px;line-height:1;font-weight:900;letter-spacing:.015em;color:#19243a;white-space:nowrap}\n    .hero-subtitle{margin-top:5px;font-size:5.1px;line-height:1.1;color:#69758b;font-weight:600;white-space:nowrap}\n    .live-button{flex:none;display:inline-flex;align-items:center;justify-content:center;min-width:52px;height:16px;padding:0 6px;border:0;border-radius:2px;background:#e8002d;color:#fff;font-size:4.6px;line-height:1;font-weight:800;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 2px 5px rgba(232,0,45,.2)}\n    .hero-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:auto;padding-top:11px}\n    .stat-label{display:block;font-size:4px;line-height:1;text-transform:uppercase;letter-spacing:.08em;color:#8a95a8;font-weight:700;white-space:nowrap}\n    .stat-value{display:block;margin-top:3px;font-size:6.5px;line-height:1;color:#263148;font-weight:800;white-space:nowrap}\n    .stat-value.red{color:#d82240}\n    .section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:4px;margin:13px 0 7px}\n    .section-kicker{font-size:5.2px;line-height:1;text-transform:uppercase;letter-spacing:.12em;color:#d82240;font-weight:900;margin-bottom:4px}\n    .section-title{font-size:10.4px;line-height:1;font-weight:900;letter-spacing:.015em;color:#1b263c;white-space:nowrap}\n    .filters{display:flex;align-items:center;justify-content:flex-end;gap:3px;align-self:flex-start;padding-top:3px}\n    .filter{height:13px;display:inline-flex;align-items:center;padding:0 4px;border:1px solid #dfe4ed;border-radius:3px;background:#fbfcff;color:#68758a;font-size:4.2px;line-height:1;font-weight:700;white-space:nowrap;box-shadow:0 1px 2px rgba(28,41,66,.02)}\n    .filter.active{color:#273249;background:#f2f4f8;border-color:#d7dde8}\n    .rounds-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:5px;row-gap:10px}\n    .round-card{position:relative;min-width:0;height:75px;overflow:hidden;padding:7px 6px 6px;border:1px solid var(--line);border-radius:5px;background:var(--card);display:flex;flex-direction:column;box-shadow:0 1px 2px rgba(25,38,63,.015)}\n    .round-card.past{background:#f9fafe}\n    .round-card.active{border:1px solid #e8002d;background:#fffafb;box-shadow:0 2px 7px rgba(232,0,45,.08)}\n    .round-meta{display:block;max-width:72%;font-size:4.1px;line-height:1;text-transform:uppercase;letter-spacing:.08em;color:#9aa5b7;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .active .round-meta{color:#e8002d}\n    .round-num{position:absolute;top:6px;right:6px;font-size:9px;line-height:1;color:#dfe4ec;font-weight:800;letter-spacing:-.04em}\n    .round-name{position:relative;z-index:1;margin-top:11px;max-width:100%;font-size:7.6px;line-height:1.15;color:#263148;font-weight:800;letter-spacing:-.015em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n    .round-subtitle{position:relative;z-index:1;margin-top:3px;max-width:100%;font-size:4.6px;line-height:1.1;color:#7f8a9e;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .round-footer{position:relative;z-index:1;margin-top:auto;max-width:100%;font-size:4px;line-height:1;text-transform:uppercase;letter-spacing:.04em;color:#98a3b4;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .active .round-footer{color:#e8002d}\n    .next-mark{position:absolute;top:4px;right:5px;z-index:2;padding:2px 3px 1px;border-radius:2px;background:#e8002d;color:#fff;font-size:3.5px;line-height:1;font-weight:900;letter-spacing:.05em;text-transform:uppercase}\n    .active .round-num{color:#f4c4cd}\n    </style>\n    <section aria-label=\"Next race: Spanish Grand Prix\" class=\"schedule-hero\" data-kid=\"1-1\" data-name=\"schedule hero section\">\n        <img alt=\"Washed out aerial view of a racing circuit\" data-kid=\"1-1-1\" data-name=\"hero circuit background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1699138346491-d6f4c7e04b85?auto=format&w=900&q=70&fit=crop\"/>\n        <div class=\"hero-wash\" data-kid=\"1-1-2\" data-name=\"hero gradient wash overlay\">\n        </div>\n        <div aria-hidden=\"true\" class=\"hero-grid\" data-kid=\"1-1-3\" data-name=\"hero decorative grid overlay\">\n        </div>\n        <div class=\"hero-copy\" data-kid=\"1-1-4\" data-name=\"hero content container\">\n            <div data-kid=\"1-1-4-1\" data-name=\"hero text content block\">\n                <div class=\"hero-topline\" data-kid=\"1-1-4-1-1\" data-name=\"hero metadata topline\">\n                    ROUND 14 / 24  •  FIA FORMULA 1 WORLD CHAMPIONSHIP 2026\n                </div>\n                <div class=\"hero-title-row\" data-kid=\"1-1-4-1-2\" data-name=\"hero title and call-to-action row\">\n                    <div data-kid=\"1-1-4-1-2-1\" data-name=\"hero title group\">\n                        <div class=\"hero-title\" data-kid=\"1-1-4-1-2-1-1\" data-name=\"hero race name title\">\n                            SPANISH GRAND PRIX\n                        </div>\n                        <div class=\"hero-subtitle\" data-kid=\"1-1-4-1-2-1-2\" data-name=\"hero race location subtitle\">\n                            Circuit de Barcelona-Catalunya • Montmeló, Spain\n                        </div>\n                    </div>\n                    <button aria-label=\"Open live feed\" class=\"live-button\" data-kid=\"1-1-4-1-2-2\" data-name=\"open live feed button\" type=\"button\">\n                        LIVE FEED\n                    </button>\n                </div>\n            </div>\n            <div aria-label=\"Race statistics\" class=\"hero-stats\" data-kid=\"1-1-4-2\" data-name=\"race statistics grid\">\n                <div data-kid=\"1-1-4-2-1\" data-name=\"stat block 1\">\n                    <span class=\"stat-label\" data-kid=\"1-1-4-2-1-1\" data-name=\"stat 1 label\">\n                        Track length\n                    </span>\n                    <span class=\"stat-value\" data-kid=\"1-1-4-2-1-2\" data-name=\"stat 1 value\">\n                        4.657 KM\n                    </span>\n                </div>\n                <div data-kid=\"1-1-4-2-2\" data-name=\"stat block 2\">\n                    <span class=\"stat-label\" data-kid=\"1-1-4-2-2-1\" data-name=\"stat 2 label\">\n                        Total laps\n                    </span>\n                    <span class=\"stat-value\" data-kid=\"1-1-4-2-2-2\" data-name=\"stat 2 value\">\n                        66 LAPS\n                    </span>\n                </div>\n                <div data-kid=\"1-1-4-2-3\" data-name=\"stat block 3\">\n                    <span class=\"stat-label\" data-kid=\"1-1-4-2-3-1\" data-name=\"stat 3 label\">\n                        Race date\n                    </span>\n                    <span class=\"stat-value\" data-kid=\"1-1-4-2-3-2\" data-name=\"stat 3 value\">\n                        SEP 13, 2026\n                    </span>\n                </div>\n                <div data-kid=\"1-1-4-2-4\" data-name=\"stat block 4\">\n                    <span class=\"stat-label\" data-kid=\"1-1-4-2-4-1\" data-name=\"stat 4 label\">\n                        Pole forecast\n                    </span>\n                    <span class=\"stat-value red\" data-kid=\"1-1-4-2-4-2\" data-name=\"stat 4 value\">\n                        M. VERSTAPPEN\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <div class=\"section-head\" data-kid=\"1-2\" data-name=\"section header container\">\n        <div data-kid=\"1-2-1\" data-name=\"section title group\">\n            <div class=\"section-kicker\" data-kid=\"1-2-1-1\" data-name=\"section kicker text\">\n                2026 CALENDAR ROUNDS\n            </div>\n            <div class=\"section-title\" data-kid=\"1-2-1-2\" data-name=\"section title text\">\n                ALL 24 CHAMPIONSHIP ROUNDS\n            </div>\n        </div>\n        <div aria-label=\"Calendar filters\" class=\"filters\" data-kid=\"1-2-2\" data-name=\"calendar filters container\">\n            <button class=\"filter active\" data-kid=\"1-2-2-1\" data-name=\"all rounds filter button\" type=\"button\">\n                All Rounds\n            </button>\n            <button class=\"filter\" data-kid=\"1-2-2-2\" data-name=\"european leg filter button\" type=\"button\">\n                European Leg\n            </button>\n            <button class=\"filter\" data-kid=\"1-2-2-3\" data-name=\"flyaways filter button\" type=\"button\">\n                Flyaways\n            </button>\n        </div>\n    </div>\n    <section aria-label=\"2026 championship rounds\" class=\"rounds-grid\" data-kid=\"1-3\" data-name=\"championship rounds grid\">\n        <article class=\"round-card past\" data-kid=\"1-3-1\" data-name=\"past round 01 card\">\n            <span class=\"round-meta\" data-kid=\"1-3-1-1\" data-name=\"round metadata\">\n                ROUND 01 • MAR 06–08\n            </span>\n            <span class=\"round-num\" data-kid=\"1-3-1-2\" data-name=\"round number\">\n                01\n            </span>\n            <strong class=\"round-name\" data-kid=\"1-3-1-3\" data-name=\"round name title\">\n                Australian Grand Prix\n            </strong>\n            <span class=\"round-subtitle\" data-kid=\"1-3-1-4\" data-name=\"round location subtitle\">\n                Albert Park Circuit • Melbourne\n            </span>\n            <span class=\"round-footer\" data-kid=\"1-3-1-5\" data-name=\"round footer summary\">\n                PICKS: VER, LEC, PIA\n            </span>\n        </article>\n        <article class=\"round-card past\" data-kid=\"1-3-2\" data-name=\"past round 02 card\">\n            <span class=\"round-meta\" data-kid=\"1-3-2-1\" data-name=\"round metadata\">\n                ROUND 02 • MAR 13–15\n            </span>\n            <span class=\"round-num\" data-kid=\"1-3-2-2\" data-name=\"round number\">\n                02\n            </span>\n            <strong class=\"round-name\" data-kid=\"1-3-2-3\" data-name=\"round name title\">\n                Chinese Grand Prix\n            </strong>\n            <span class=\"round-subtitle\" data-kid=\"1-3-2-4\" data-name=\"round location subtitle\">\n                Shanghai International Circuit • Shanghai\n            </span>\n            <span class=\"round-footer\" data-kid=\"1-3-2-5\" data-name=\"round footer summary\">\n                PICKS: VER, RUS, PIA\n            </span>\n        </article>\n        <article class=\"round-card past\" data-kid=\"1-3-3\" data-name=\"past round 03 card\">\n            <span class=\"round-meta\" data-kid=\"1-3-3-1\" data-name=\"round metadata\">\n                ROUND 03 • MAR 27–29\n            </span>\n            <span class=\"round-num\" data-kid=\"1-3-3-2\" data-name=\"round number\">\n                03\n            </span>\n            <strong class=\"round-name\" data-kid=\"1-3-3-3\" data-name=\"round name title\">\n                Japanese Grand Prix\n            </strong>\n            <span class=\"round-subtitle\" data-kid=\"1-3-3-4\" data-name=\"round location subtitle\">\n                Suzuka International Racing Course • Suzuka\n            </span>\n            <span class=\"round-footer\" data-kid=\"1-3-3-5\" data-name=\"round footer summary\">\n                PICKS: VER, LEC, NOR\n            </span>\n        </article>\n        <article class=\"round-card past\" data-kid=\"1-3-4\" data-name=\"past round 04 card\">\n            <span class=\"round-meta\" data-kid=\"1-3-4-1\" data-name=\"round metadata\">\n                ROUND 04 • APR 10–12\n            </span>\n            <span class=\"round-num\" data-kid=\"1-3-4-2\" data-name=\"round number\">\n                04\n            </span>\n            <strong class=\"round-name\" data-kid=\"1-3-4-3\" data-name=\"round name title\">\n                Bahrain Grand Prix\n            </strong>\n            <span class=\"round-subtitle\" data-kid=\"1-3-4-4\" d